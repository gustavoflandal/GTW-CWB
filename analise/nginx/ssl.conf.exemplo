# =============================================================================
# Nginx — Proxy reverso com TLS para o Apache Superset (PRODUCAO)
#
# Uso: copiar para ssl.conf, ajustar certificado e chave, e referenciar
#      no docker-compose.prod.yml no volume do nginx.
#
# Requisitos:
#   - Certificado TLS: /etc/nginx/ssl/cert.pem
#   - Chave privada:   /etc/nginx/ssl/key.pem
#   - Opcional: CA intermediaria concatenada no cert.pem
# =============================================================================

upstream superset_upstream {
    server superset:8088;
}

# Redireciona HTTP para HTTPS
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name _;

    # -------------------------------------------------------------------------
    # Certificado TLS
    # -------------------------------------------------------------------------
    ssl_certificate     /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS (ativar apenas apos confirmar que TLS funciona)
    # add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    client_max_body_size 50m;

    # -------------------------------------------------------------------------
    # Sub-requisicao de autenticacao SSO
    # -------------------------------------------------------------------------
    location = /auth {
        internal;
        proxy_pass              http://host.docker.internal:8080/MuralhaDigital/SsoAnalise?acao=validar;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length "";
        proxy_set_header        X-Original-URI $request_uri;
        proxy_set_header        Cookie $http_cookie;
    }

    # -------------------------------------------------------------------------
    # Localizacao principal — proxy para o Superset
    # -------------------------------------------------------------------------
    location / {
        auth_request /auth;

        auth_request_set $gtw_usuario  $upstream_http_x_gtw_usuario;
        auth_request_set $gtw_user_id  $upstream_http_x_gtw_userid;
        auth_request_set $gtw_grupos   $upstream_http_x_gtw_grupos;

        proxy_set_header X-GTW-Usuario  $gtw_usuario;
        proxy_set_header X-GTW-UserId   $gtw_user_id;
        proxy_set_header X-GTW-Grupos   $gtw_grupos;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_pass http://superset_upstream;

        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
    }

    # -------------------------------------------------------------------------
    # API do Superset
    # -------------------------------------------------------------------------
    location /api/ {
        auth_request /auth;

        auth_request_set $gtw_usuario  $upstream_http_x_gtw_usuario;
        auth_request_set $gtw_user_id  $upstream_http_x_gtw_userid;
        auth_request_set $gtw_grupos   $upstream_http_x_gtw_grupos;

        proxy_set_header X-GTW-Usuario  $gtw_usuario;
        proxy_set_header X-GTW-UserId   $gtw_user_id;
        proxy_set_header X-GTW-Grupos   $gtw_grupos;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_pass http://superset_upstream;
    }

    # -------------------------------------------------------------------------
    # Assets estaticos
    # -------------------------------------------------------------------------
    location /static/ {
        proxy_pass http://superset_upstream;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # -------------------------------------------------------------------------
    # Health check
    # -------------------------------------------------------------------------
    location /nginx-health {
        access_log off;
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    # -------------------------------------------------------------------------
    # Erro 401 — redireciona ao login do GTW
    # -------------------------------------------------------------------------
    error_page 401 = @login_redirect;
    location @login_redirect {
        return 302 https://$host:8080/muralha-digital/pages/login/login.jsp?retorno=/analise/;
    }
}
