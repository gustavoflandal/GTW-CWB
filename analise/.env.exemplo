# ==============================================================================
# Variáveis de ambiente — Apache Superset (Análises GTW-CWB)
# ==============================================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o .env no git — ele contém segredos.
# ==============================================================================

# ------------------------------------------------------------------------------
# Superset — chave secreta (obrigatória, única por instalação)
# Gere com:  openssl rand -base64 42
# ------------------------------------------------------------------------------
SUPERSET_SECRET_KEY=ALTERE_AQUI_gere_com_openssl_rand_base64_42

# ------------------------------------------------------------------------------
# Superset — usuário administrador inicial (criado pelo container de init)
# ------------------------------------------------------------------------------
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=ALTERE_AQUI_senha_forte
SUPERSET_ADMIN_FIRST_NAME=Administrador
SUPERSET_ADMIN_LAST_NAME=GTW
SUPERSET_ADMIN_EMAIL=admin@muralhadigital.local

# ------------------------------------------------------------------------------
# Banco de dados do GTW (SQL Server, somente leitura)
# O Superset conecta com allow_dml=False, sem CTAS/CVAS/upload.
# ------------------------------------------------------------------------------
GTW_DB_HOST=10.0.0.200
GTW_DB_PORT=1433
GTW_DB_NAME=GTW_MURALHA_DEV
GTW_DB_USER=consilux
GTW_DB_PASSWORD=ALTERE_AQUI_senha_do_banco

# ------------------------------------------------------------------------------
# Banco de metadados do Superset (PostgreSQL interno ao Compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=superset
POSTGRES_PASSWORD=ALTERE_AQUI_senha_postgres
SUPERSET_DB_URI=postgresql+psycopg2://superset:ALTERE_AQUI_senha_postgres@postgres:5432/superset

# ------------------------------------------------------------------------------
# Redis (cache e fila Celery)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Mapeamento grupo GTW → papel Superset (JSON)
# Chave = id do grupo em dbo.sis_grupo; Valor = nome do papel no Superset
# Exemplo: grupo 11 = Admin, grupo 41 = Alpha (cria), grupo 42 = Gamma (consome)
# ------------------------------------------------------------------------------
GTW_GRUPOS_PAPEIS={"11":"Admin","41":"Alpha","42":"Gamma"}

# ------------------------------------------------------------------------------
# SSO — segredo HMAC compartilhado entre o GTW e o nginx/Superset
# Deve ser idêntico ao configurado no SsoAnaliseServlet do GTW.
# Gere com:  openssl rand -base64 32
# ------------------------------------------------------------------------------
GTW_SSO_HMAC_SECRET=ALTERE_AQUI_gere_com_openssl_rand_base64_32

# ------------------------------------------------------------------------------
# URL base do GTW (para redirecionamento ao login e chamadas de API)
# ------------------------------------------------------------------------------
GTW_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# SMTP — envio de alertas e relatórios agendados
# Usa o mesmo servidor SMTP do módulo de Chamados (Plano 22).
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_USER=ALTERE_AQUI_usuario_smtp
SMTP_PASSWORD=ALTERE_AQUI_senha_smtp
SMTP_MAIL_FROM=analises@muralhadigital.local
SMTP_STARTTLS=true
SMTP_SSL=false

# ------------------------------------------------------------------------------
# Observabilidade (SUP-6) — opcional
# Se STATSD_HOST estiver vazio, métricas StatsD são desabilitadas.
# ------------------------------------------------------------------------------
SUPERSET_LOG_LEVEL=INFO
STATSD_HOST=
STATSD_PORT=8125

# ------------------------------------------------------------------------------
# Desempenho (SUP-12) — opcional
# Timeout do webserver Gunicorn (segundos); padrao 60.
# ------------------------------------------------------------------------------
SUPERSET_WEBSERVER_TIMEOUT=60
