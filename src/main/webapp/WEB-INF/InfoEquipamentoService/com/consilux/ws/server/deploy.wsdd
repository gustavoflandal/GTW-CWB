<?xml version="1.0" encoding="UTF-8"?><!-- Use this file to deploy some handlers/chains and services      --><!-- Two ways to do this:                                           --><!--   java org.apache.axis.client.AdminClient deploy.wsdd          --><!--      after the axis server is running                          --><!-- or                                                             --><!--   java org.apache.axis.utils.Admin client|server deploy.wsdd   --><!--      from the same directory that the Axis engine runs         --><deployment xmlns="http://xml.apache.org/axis/wsdd/" xmlns:java="http://xml.apache.org/axis/wsdd/providers/java">

  <!-- Services from InfoEquipamentoService WSDL service -->

  <service name="InfoEquipamento" provider="java:RPC" style="wrapped" use="literal">
      <parameter name="wsdlTargetNamespace" value="http://server.ws.consilux.com"/>
      <parameter name="wsdlServiceElement" value="InfoEquipamentoService"/>
      <parameter name="schemaQualified" value="http://beans.model.consilux.com,http://server.ws.consilux.com"/>
      <parameter name="wsdlServicePort" value="InfoEquipamento"/>
      <parameter name="className" value="com.consilux.ws.server.InfoEquipamento"/>
      <parameter name="wsdlPortType" value="InfoEquipamento"/>
      <parameter name="typeMappingVersion" value="1.2"/>
      <operation xmlns:operNS="http://server.ws.consilux.com" xmlns:retNS="http://server.ws.consilux.com" xmlns:rtns="http://beans.model.consilux.com" name="getLocaisVigente" qname="operNS:getLocaisVigente" returnQName="retNS:getLocaisVigenteReturn" returnType="rtns:LocalVigenteBean" soapAction="">
        <parameter xmlns:pns="http://server.ws.consilux.com" xmlns:tns="http://www.w3.org/2001/XMLSchema" qname="pns:usuario" type="tns:string"/>
        <parameter xmlns:pns="http://server.ws.consilux.com" xmlns:tns="http://www.w3.org/2001/XMLSchema" qname="pns:senha" type="tns:string"/>
        <parameter xmlns:pns="http://server.ws.consilux.com" xmlns:tns="http://www.w3.org/2001/XMLSchema" qname="pns:idGrupo" type="tns:int"/>
      </operation>
      <parameter name="allowedMethods" value="getLocaisVigente"/>

      <typeMapping xmlns:ns="http://beans.model.consilux.com" qname="ns:LocalVigenteBean" type="java:com.consilux.model.beans.LocalVigenteBean" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle=""/>
  </service>
</deployment>