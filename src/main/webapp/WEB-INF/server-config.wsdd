   <ns1:parameter qname="ns7:senha" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <ns1:parameter qname="ns7:idEquipamento" type="xsd:int" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
