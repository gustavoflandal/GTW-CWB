   <ns1:parameter qname="ns8:xmlConfigEquip" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
  </ns1:operation>
  <ns1:operation name="validarUsuario" qname="ns9:validarUsuario" returnQName="ns9:validarUsuarioReturn" returnType="xsd:boolean" soapAction="" xmlns:ns9="http://server.ws.consilux.com" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
   <ns1:parameter qname="ns9:usuario" type="xsd:string"/>
   <ns1:parameter qname="ns9:senha" type="xsd:string"/>
  </ns1:operation>
  <ns1:parameter name="allowedMethods" value="validarUsuario setEmOperacao incluirConfigEquip buscarConfigEquip buscaDataModificacaoConfigEquip"/>
  <ns1:parameter name="wsdlPortType" value="ConfigEquip"/>
  <ns1:parameter name="typeMappingVersion" value="1.2"/>
  <ns1:parameter name="schemaQualified" value="http://server.ws.consilux.com"/>
  <ns1:parameter name="wsdlServicePort" value="ConfigEquip"/>
  <ns1:parameter name="className" value="com.consilux.ws.server.ConfigEquipWS"/>
  <ns1:parameter name="wsdlTargetNamespace" value="http://server.ws.consilux.com"/>
  <ns1:parameter name="wsdlServiceElement" value="ConfigEquipService"/>
 </ns1:service>
 <ns1:service name="CSXEventsWS" provider="java:RPC" style="wrapped" use="literal">
  <ns1:operation name="registrarEvento" qname="ns10:registrarEvento" soapAction="" xmlns:ns10="http://server.ws.consilux.com">
   <ns1:parameter qname="ns10:xmlCSXEvent" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
