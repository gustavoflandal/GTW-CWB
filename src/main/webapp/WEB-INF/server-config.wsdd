  <ns1:parameter name="wsdlServicePort" value="VeiculoMonitoradoWS"/>
  <ns1:parameter name="schemaQualified" value="http://custom.namespace"/>
  <ns1:parameter name="wsdlTargetNamespace" value="http://custom.namespace"/>
  <ns1:parameter name="wsdlServiceElement" value="VeiculoMonitoradoWSService"/>
 </ns1:service>
 <ns1:service name="ConfigEquipWS" provider="java:RPC" style="wrapped" use="literal">
