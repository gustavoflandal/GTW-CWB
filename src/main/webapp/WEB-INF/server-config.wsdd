<ns1:deployment xmlns="http://xml.apache.org/axis/wsdd/" xmlns:java="http://xml.apache.org/axis/wsdd/providers/java" xmlns:ns1="http://xml.apache.org/axis/wsdd/">
 <ns1:globalConfiguration>
  <ns1:parameter name="sendMultiRefs" value="true"/>
  <ns1:parameter name="disablePrettyXML" value="true"/>
  <ns1:parameter name="adminPassword" value="admin"/>
  <ns1:parameter name="dotNetSoapEncFix" value="true"/>
  <ns1:parameter name="enableNamespacePrefixOptimization" value="false"/>
  <ns1:parameter name="sendXMLDeclaration" value="true"/>
  <ns1:parameter name="attachments.implementation" value="org.apache.axis.attachments.AttachmentsImpl"/>
  <ns1:parameter name="sendXsiTypes" value="true"/>
  <ns1:requestFlow>
   <ns1:handler type="java:org.apache.axis.handlers.JWSHandler">
    <ns1:parameter name="scope" value="session"/>
   </ns1:handler>
   <ns1:handler type="java:org.apache.axis.handlers.JWSHandler">
    <ns1:parameter name="scope" value="request"/>
    <ns1:parameter name="extension" value=".jwr"/>
   </ns1:handler>
  </ns1:requestFlow>
 </ns1:globalConfiguration>
 <ns1:handler name="URLMapper" type="java:org.apache.axis.handlers.http.URLMapper"/>
 <ns1:handler name="LocalResponder" type="java:org.apache.axis.transport.local.LocalResponder"/>
 <ns1:handler name="Authenticate" type="java:org.apache.axis.handlers.SimpleAuthenticationHandler"/>
 <ns1:service name="InfoEquipamento" provider="java:RPC" style="wrapped" use="literal">
  <ns3:operation name="getLocaisVigente" qname="ns1:getLocaisVigente" returnQName="ns1:getLocaisVigenteReturn" returnType="ns2:LocalVigenteBean" soapAction="" xmlns:ns1="http://server.ws.consilux.com" xmlns:ns2="http://beans.model.consilux.com" xmlns:ns3="http://xml.apache.org/axis/wsdd/">
   <ns3:parameter qname="ns1:usuario" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <ns3:parameter qname="ns1:senha" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <ns3:parameter qname="ns1:idGrupo" type="xsd:int" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
  </ns3:operation>
  <ns1:parameter name="allowedMethods" value="getLocaisVigente"/>
  <ns1:parameter name="wsdlPortType" value="InfoEquipamento"/>
  <ns1:parameter name="typeMappingVersion" value="1.2"/>
  <ns1:parameter name="schemaQualified" value="http://beans.model.consilux.com,http://server.ws.consilux.com"/>
  <ns1:parameter name="wsdlServicePort" value="InfoEquipamento"/>
  <ns1:parameter name="className" value="com.consilux.ws.server.InfoEquipamento"/>
  <ns1:parameter name="wsdlTargetNamespace" value="http://server.ws.consilux.com"/>
  <ns1:parameter name="wsdlServiceElement" value="InfoEquipamentoService"/>
  <ns1:typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns3:LocalVigenteBean" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.consilux.model.beans.LocalVigenteBean" xmlns:ns3="http://beans.model.consilux.com"/>
 </ns1:service>
 <ns1:service name="StatusEquipamento" provider="java:RPC" style="wrapped" use="literal">
  <ns1:operation name="statusAlterado" qname="ns4:statusAlterado" soapAction="" xmlns:ns4="http://server.ws.consilux.com">
   <ns1:parameter qname="ns4:idEquipamento" type="xsd:int" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
  </ns1:operation>
  <ns1:parameter name="allowedMethods" value="statusAlterado"/>
  <ns1:parameter name="typeMappingVersion" value="1.2"/>
  <ns1:parameter name="wsdlPortType" value="StatusEquipamento"/>
  <ns1:parameter name="className" value="com.consilux.ws.server.StatusEquipamento"/>
  <ns1:parameter name="wsdlServicePort" value="StatusEquipamento"/>
  <ns1:parameter name="schemaQualified" value="http://server.ws.consilux.com"/>
  <ns1:parameter name="wsdlTargetNamespace" value="http://server.ws.consilux.com"/>
  <ns1:parameter name="wsdlServiceElement" value="StatusEquipamentoService"/>
 </ns1:service>
 <ns1:service name="ConfigEquip" provider="java:RPC" style="wrapped" use="literal">
  <ns1:operation name="buscaDataModificacaoConfigEquip" qname="ns5:buscaDataModificacaoConfigEquip" returnQName="ns5:buscaDataModificacaoConfigEquipReturn" returnType="xsd:double" soapAction="" xmlns:ns5="http://server.ws.consilux.com" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
