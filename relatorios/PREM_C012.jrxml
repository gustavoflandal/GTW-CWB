	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="ID_REMESSA" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGENS" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Documents and Settings\\fos\\workspace\\GTW\\WebContent\\WEB-INF\\img"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[select
TOP(1) 
CONVERT(VARCHAR,getDate(),3) AS DATA_EXPEDICAO,
r.data AS DATA_MOVIMENTO,
CAST(r.codigo_externo AS INTEGER) AS NUMERO_LOTE,
right('000000'+RTRIM(r.codigo_externo), 6) AS NUMERO_REMESSA,
r.total_infracao AS TOTAL_AIT,
RTRIM(r.serie_inicial) AS SERIE_AIT_INI,
r.auto_inicial AS NUMERO_AIT_INI,
dbo.DAC_AIT(r.tipo,r.serie_inicial,r.auto_inicial) AS DAC_AIT_INI,
RTRIM(r.serie_final) AS SERIE_AIT_FIM,
r.auto_final AS NUMERO_AIT_FIM,
dbo.DAC_AIT(r.tipo,r.serie_final,r.auto_final) AS DAC_AIT_FIM,
RTRIM(r.tipo) AS TIPO,
CAST(CONVERT(date, i.data, 120) AS DATE) AS DATA_INFRACAO,
total_infracao AS NUMERO_IMAGENS,
(SELECT valor FROM chave_valor (NOLOCK) WHERE chave = 'nome_contato_remessa') AS NOME_CONTATO,
(SELECT valor FROM chave_valor (NOLOCK) WHERE chave = 'matricula_remessa') AS MATRICULA_CONTATO,
(SELECT RIGHT('000' + LTRIM(RTRIM(valor)), 3) AS numero_contrato FROM chave_valor WHERE chave = 'numero_contrato') AS NUMERO_CONTRATO,
(SELECT RIGHT('0000' + LTRIM(RTRIM(valor)), 4) AS ano_contrato FROM chave_valor WHERE chave = 'ano_contrato') AS ANO_CONTRATO
FROM remessa r
JOIN infracao_remessa ir ON ir.id_remessa = r.id_remessa
JOIN infracao i ON i.id_infracao = ir.id_infracao
WHERE r.id_remessa = $P{ID_REMESSA}]]>
	</queryString>
