				</barPlot>
			</barChart>
			<staticText>
				<reportElement x="0" y="0" width="555" height="25"/>
				<box topPadding="1" leftPadding="1" bottomPadding="1" rightPadding="1"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Calibri" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Nº de infrações/volume de tráfego por Dia]]></text>
			</staticText>
			<barChart>
				<chart isShowLegend="false" customizerClass="com.consilux.infra.CsxBarChartCustomizer" renderType="draw">
					<reportElement x="0" y="280" width="555" height="170"/>
					<box topPadding="0"/>
					<chartTitle/>
					<chartSubtitle/>
					<chartLegend position="Bottom"/>
				</chart>
				<categoryDataset>
					<dataset>
						<datasetRun subDataset="conta_infracao_semana">
							<datasetParameter name="COD_PISTA">
								<datasetParameterExpression><![CDATA[$F{cod_pista}]]></datasetParameterExpression>
							</datasetParameter>
							<datasetParameter name="DATA_INI">
								<datasetParameterExpression><![CDATA[$F{data_ini}]]></datasetParameterExpression>
							</datasetParameter>
