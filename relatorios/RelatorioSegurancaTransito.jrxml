						</axisFormat>
					</categoryAxisFormat>
					<valueAxisLabelExpression><![CDATA["Quantidade de Infrações"]]></valueAxisLabelExpression>
					<valueAxisFormat>
						<axisFormat labelColor="#000000" tickLabelColor="#000000" verticalTickLabels="false" axisLineColor="#000000">
							<labelFont/>
