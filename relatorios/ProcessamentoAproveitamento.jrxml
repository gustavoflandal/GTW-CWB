<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ProcessamentoAproveitamento" pageWidth="595" pageHeight="842" whenNoDataType="BlankPage" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="dfddd838-c69d-4d04-b13d-f2b0d5035b77">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="21"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="C013"/>
	<parameter name="DATA_INICIAL" class="java.sql.Timestamp"/>
	<parameter name="DATA_FINAL" class="java.sql.Timestamp"/>
	<parameter name="CONTRATO" class="java.lang.String"/>
	<queryString>
		<![CDATA[DECLARE @data_inicial DATETIME
DECLARE @data_final DATETIME

-- periodo
SET @data_inicial = $P{DATA_INICIAL}
SET @data_final = $P{DATA_FINAL}

DECLARE @imagens_recebidas_no_CPI INT
DECLARE @imagens_consistentes_pela_empresa INT
DECLARE @imagens_inconsistentes_pela_empresa INT
DECLARE @consistente_validas INT
DECLARE @consistente_invalidas INT
DECLARE @inconsistente_validas INT
DECLARE @inconsistente_invalidas INT
DECLARE @consistente_invalidas_pnt INT
DECLARE @inconsistente_invalidas_pnt INT
DECLARE @invalido_pt INT


/***************************************************
 Quantidade de imagens recebidas no CPI:  (100%);
***************************************************/

	SELECT @imagens_recebidas_no_CPI = COUNT(*)
	FROM   infracao inf (NOLOCK)
	WHERE  inf.data >= @data_inicial AND inf.data <= @data_final -- periodo
		   AND (inf.id_processo <> 99 AND inf.id_processo_concluido <> 99)
		   AND id_enquadramento <> 1 -- ignora imagens teste

/***************************************************
 Após avaliação da empresa:
	(estado da liberação foi decisão da empresa)
***************************************************/

/***************************************************
	quantidade de imagens consistentes:
****************************************************/

	SELECT @imagens_consistentes_pela_empresa = COUNT(*)
	FROM   infracao inf (NOLOCK)
		   JOIN (
					SELECT id_infracao,
						   MAX(id_infracao_processo) as id_infracao_processo
					FROM   infracao_processo (NOLOCK)
					WHERE  id_processo IN (1,2,24)
					GROUP BY
						   id_infracao
		   ) AS sub
				ON  sub.id_infracao = inf.id_infracao
		   JOIN infracao_processo ipc (NOLOCK)
				ON  sub.id_infracao_processo = ipc.id_infracao_processo
	WHERE  inf.data >= @data_inicial AND inf.data <= @data_final -- periodo
		   AND (inf.id_processo <> 99 AND inf.id_processo_concluido <> 99)
		   AND id_enquadramento <> 1 -- ignora imagens teste
		   AND ipc.id_processo IN (1,2,24) -- passaram pela digitação
		   AND ipc.id_inconsistencia = 0


/***************************************************
 quantidade de imagens inconsistentes:
****************************************************/

	SELECT @imagens_inconsistentes_pela_empresa = COUNT(*)
	FROM   infracao inf (NOLOCK)
		   JOIN (
					SELECT id_infracao,
						   MAX(id_infracao_processo) AS id_infracao_processo
					FROM   infracao_processo (NOLOCK)
					WHERE  id_processo IN (1,2,24)
					GROUP BY
						   id_infracao
		   ) sub
				ON  sub.id_infracao = inf.id_infracao
		   JOIN infracao_processo ipc (NOLOCK)
				ON  sub.id_infracao_processo = ipc.id_infracao_processo
	WHERE  inf.data >= @data_inicial AND inf.data <= @data_final -- periodo
		   AND (inf.id_processo <> 99 AND inf.id_processo_concluido <> 99)
		   AND id_enquadramento <> 1 -- ignora imagens teste
		   AND ipc.id_processo IN (1,2,24) -- passaram pela liberação
		   AND ipc.id_inconsistencia > 0



/***************************************************
 Após auditoria da CET:
***************************************************/

/*********************************************************
	Nas imagens consistentes
**********************************************************/

	/*********************************************************
	válidas
	**********************************************************/

	SELECT @consistente_validas = COUNT(*)
	FROM   infracao inf (NOLOCK)
		   JOIN (
					SELECT id_infracao,
						   MAX(id_infracao_processo) AS id_infracao_processo
					FROM   infracao_processo (NOLOCK)
					WHERE  id_processo IN (1,2,24)
					GROUP BY
						   id_infracao
		   ) sub
				ON  sub.id_infracao = inf.id_infracao
		   JOIN infracao_processo ipc (NOLOCK)
				ON  sub.id_infracao_processo = ipc.id_infracao_processo
	WHERE  inf.data >= @data_inicial AND inf.data <= @data_final -- periodo
		   AND (inf.id_processo <> 99 AND inf.id_processo_concluido <> 99)
		   AND id_enquadramento <> 1 -- ignora imagens teste
		   AND ipc.id_processo IN (1,2,24) -- passaram pela digitação
		   AND inf.id_inconsistencia = 0 -- validas
		   AND ipc.id_inconsistencia = 0 -- consistentes pela consilux

	/*********************************************************
	inválidas
	**********************************************************/

	SELECT @consistente_invalidas = COUNT(*)
	FROM   infracao inf (NOLOCK)
		   JOIN (
					SELECT id_infracao,
						   MAX(id_infracao_processo) AS id_infracao_processo
					FROM   infracao_processo (NOLOCK)
					WHERE  id_processo IN (1,2,24)
					GROUP BY
						   id_infracao
		   ) sub
				ON  sub.id_infracao = inf.id_infracao
		   JOIN infracao_processo ipc (NOLOCK)
				ON  sub.id_infracao_processo = ipc.id_infracao_processo
	WHERE  inf.data >= @data_inicial AND inf.data <= @data_final -- periodo
		   AND (inf.id_processo <> 99 AND inf.id_processo_concluido <> 99)
		   AND id_enquadramento <> 1 -- ignora imagens teste
		   AND ipc.id_processo IN (1,2,24) -- passaram pela digitação
		   AND inf.id_inconsistencia > 0 -- invalidas
		   AND ipc.id_inconsistencia = 0 -- consistentes pela consilux


/*********************************************************
	Nas imagens inconsistentes
**********************************************************/

	/*********************************************************
	válidas
	**********************************************************/


	SELECT @inconsistente_validas = COUNT(*)
	FROM   infracao inf (NOLOCK)
		   JOIN (
					SELECT id_infracao,
						   MAX(id_infracao_processo) AS id_infracao_processo
					FROM   infracao_processo (NOLOCK)
					WHERE  id_processo IN (1,2,24)
					GROUP BY
						   id_infracao
		   ) sub
				ON  sub.id_infracao = inf.id_infracao
		   JOIN infracao_processo ipc (NOLOCK)
				ON  sub.id_infracao_processo = ipc.id_infracao_processo
	WHERE  inf.data >= @data_inicial AND inf.data <= @data_final -- periodo
		   AND (inf.id_processo <> 99 AND inf.id_processo_concluido <> 99)
		   AND id_enquadramento <> 1 -- ignora imagens teste
		   AND ipc.id_processo IN (1,2,24) -- passaram pela digitação
		   AND inf.id_inconsistencia = 0 -- validas
		   AND ipc.id_inconsistencia > 0 -- inconsistentes pela consilux


	/*********************************************************
	inválidas
	**********************************************************/

	SELECT @inconsistente_invalidas = COUNT(*)
	FROM   infracao inf (NOLOCK)
		   JOIN (
					SELECT id_infracao,
						   MAX(id_infracao_processo) AS id_infracao_processo
					FROM   infracao_processo (NOLOCK)
					WHERE  id_processo IN (1,2,24)
					GROUP BY
						   id_infracao
		   ) sub
				ON  sub.id_infracao = inf.id_infracao
		   JOIN infracao_processo ipc (NOLOCK)
				ON  sub.id_infracao_processo = ipc.id_infracao_processo
	WHERE  inf.data >= @data_inicial AND inf.data <= @data_final -- periodo
		   AND (inf.id_processo <> 99 AND inf.id_processo_concluido <> 99)
		   AND id_enquadramento <> 1 -- ignora imagens teste
		   AND ipc.id_processo IN (1,2,24) -- passaram pela digitação
		   AND inf.id_inconsistencia > 0 -- invalidas
		   AND ipc.id_inconsistencia > 0 -- inconsistente pela consilux


/*********************************************************
Quantidade de imagens consistentes inválidas (exceto por problema técnico)
**********************************************************/

	SELECT @consistente_invalidas_pnt = COUNT(*)
	FROM   infracao inf (NOLOCK)
		   JOIN (
					SELECT id_infracao,
						   MAX(id_infracao_processo) AS id_infracao_processo
					FROM   infracao_processo (NOLOCK)
					WHERE  id_processo IN (1,2,24)
					GROUP BY
						   id_infracao
		   ) sub
				ON  sub.id_infracao = inf.id_infracao
		   JOIN infracao_processo ipc (NOLOCK)
				ON  sub.id_infracao_processo = ipc.id_infracao_processo
		   JOIN inconsistencia inc (NOLOCK)
				ON  inc.id_inconsistencia = inf.id_inconsistencia
	WHERE  inf.data >= @data_inicial AND inf.data <= @data_final -- periodo
		   AND (inf.id_processo <> 99 AND inf.id_processo_concluido <> 99)
		   AND id_enquadramento <> 1 -- ignora imagens teste
		   AND ipc.id_processo IN (1,2,24) -- passaram pela digitação
		   AND inf.id_inconsistencia > 0
		   AND ipc.id_inconsistencia = 0
		   AND inc.razao_tecnica <> 2


/*********************************************************
Quantidade de imagens inconsistentes inválidas (exceto por problema técnico)
*********************************************************/

	SELECT @inconsistente_invalidas_pnt = COUNT(*)
	FROM   infracao inf (NOLOCK)
		   JOIN (
					SELECT id_infracao,
						   MAX(id_infracao_processo) AS id_infracao_processo
					FROM   infracao_processo (NOLOCK)
					WHERE  id_processo IN (1,2,24)
					GROUP BY
						   id_infracao
		   ) sub
				ON  sub.id_infracao = inf.id_infracao
		   JOIN infracao_processo ipc (NOLOCK)
				ON  sub.id_infracao_processo = ipc.id_infracao_processo
		   JOIN inconsistencia inc (NOLOCK)
				ON  inc.id_inconsistencia = inf.id_inconsistencia
	WHERE  inf.data >= @data_inicial AND inf.data <= @data_final -- periodo
		   AND (inf.id_processo <> 99 AND inf.id_processo_concluido <> 99)
		   AND id_enquadramento <> 1 -- ignora imagens teste
		   AND ipc.id_processo IN (1,2,24) -- passaram pela digitação
		   AND inf.id_inconsistencia > 0
		   AND ipc.id_inconsistencia > 0
		   AND inc.razao_tecnica <> 2

/*********************************************************
Quantidade de imagens descartadas por problema técnico:
**********************************************************/
	SELECT @invalido_pt = COUNT(*)
	FROM   infracao inf (NOLOCK)
		   JOIN inconsistencia inc (NOLOCK)
				ON  inf.id_inconsistencia = inc.id_inconsistencia
	WHERE  inf.data >= @data_inicial AND inf.data <= @data_final -- periodo
		   AND (inf.id_processo <> 99 AND inf.id_processo_concluido <> 99)
		   AND id_enquadramento <> 1 -- ignora imagens teste
		   AND inf.id_inconsistencia > 0
		   AND inc.razao_tecnica = 2

/*****************************************************************************************************
Deverá ser inserida uma tabela contendo TODOS os motivos das inconsistências
(descrever o motivo, a quantidade e a porcentagem da incidência sobre o total,
citANDo tratar-se de problema técnico ou não). Juntar as Não-Técnicas e depois as Técnicas
******************************************************************************************************/

	SELECT [cod.] = inf.id_inconsistencia,
		   motivo = inc.descricao,
		   COUNT(*) as Quantidade,
		   CONVERT(VARCHAR(6), CAST( CAST( COUNT(*) AS float ) / @imagens_recebidas_no_CPI * 100 AS DECIMAL(5,1))) AS [(%)],
		   inc.Problema,
		   @imagens_recebidas_no_CPI AS imagens_recebidas_no_CPI,
		   @imagens_consistentes_pela_empresa AS imagens_consistentes_pela_empresa,
		   @imagens_inconsistentes_pela_empresa AS imagens_inconsistentes_pela_empresa,
		   @consistente_validas AS consistente_validas,
		   @consistente_invalidas AS consistente_invalidas,
		   @inconsistente_validas AS inconsistente_validas,
		   @inconsistente_invalidas AS inconsistente_invalidas,
		   @consistente_invalidas_pnt AS consistente_invalidas_pnt,
		   @inconsistente_invalidas_pnt AS inconsistente_invalidas_pnt,
		   @invalido_pt AS invalido_pt
	FROM   infracao inf (NOLOCK)
		   JOIN (
					SELECT id_inconsistencia,
						   descricao,
						   (CASE WHEN razao_tecnica = 0 THEN 'Não-técnica'
								 WHEN razao_tecnica = 2 THEN 'Técnica'
								 WHEN razao_tecnica = 1 THEN 'Não-técnica *'
								 ELSE NULL END) AS Problema
					FROM   inconsistencia (NOLOCK)
		   ) inc
				ON  inf.id_inconsistencia = inc.id_inconsistencia
	WHERE  inf.data >= @data_inicial AND inf.data <= @data_final -- periodo
		   AND (inf.id_processo <> 99 AND inf.id_processo_concluido <> 99)
		   AND id_enquadramento <> 1 -- ignora imagens teste
		   AND inf.id_inconsistencia > 0
	GROUP BY
		   inf.id_inconsistencia,
		   inc.descricao,
		   inc.Problema
	ORDER BY 5 ASC]]>
	</queryString>
	<field name="cod." class="java.lang.Integer"/>
	<field name="motivo" class="java.lang.String"/>
	<field name="Quantidade" class="java.lang.Integer"/>
	<field name="(%)" class="java.lang.String"/>
	<field name="Problema" class="java.lang.String"/>
	<field name="imagens_recebidas_no_CPI" class="java.lang.Integer"/>
	<field name="imagens_consistentes_pela_empresa" class="java.lang.Integer"/>
	<field name="imagens_inconsistentes_pela_empresa" class="java.lang.Integer"/>
	<field name="consistente_validas" class="java.lang.Integer"/>
	<field name="consistente_invalidas" class="java.lang.Integer"/>
	<field name="inconsistente_validas" class="java.lang.Integer"/>
	<field name="inconsistente_invalidas" class="java.lang.Integer"/>
	<field name="consistente_invalidas_pnt" class="java.lang.Integer"/>
	<field name="inconsistente_invalidas_pnt" class="java.lang.Integer"/>
	<field name="invalido_pt" class="java.lang.Integer"/>
