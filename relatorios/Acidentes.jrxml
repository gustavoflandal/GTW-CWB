	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="ENDERECO" isForPrompting="true" class="java.lang.String"/>
	<parameter name="DATA_INI" isForPrompting="true" class="java.sql.Timestamp"/>
	<parameter name="DATA_FIM" isForPrompting="true" class="java.sql.Timestamp"/>
	<parameter name="TIPO_GRAVIDADE" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="TIPO_ILUMINACAO" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="TIPO_AREA" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="TIPO_EQUIPAMENTO_SEGURANCA" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="SEXO" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="FAIXA_ETARIA" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="TIPO_VEICULO" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="TIPO_ACIDENTE" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT a.data AS Data, a.endereco,
CASE a.tipo_acidente
WHEN 1 THEN 'ATROPELAMENTO'
WHEN 2 THEN 'CAPOTAMENTO'
WHEN 3 THEN 'TOMBAMENTO'
WHEN 4 THEN 'COLISÃO FRONTAL'
WHEN 5 THEN 'COLISÃO TRASEIRA'
END AS "Tipo Acidente"
FROM acidente a
WHERE 
a.data BETWEEN $P{DATA_INI} AND $P{DATA_FIM} AND
(a.endereco LIKE $P{ENDERECO}) AND 
($P{TIPO_GRAVIDADE} = 0 OR a.tipo_gravidade = $P{TIPO_GRAVIDADE}) AND 
($P{TIPO_ILUMINACAO} = 0 OR a.tipo_iluminacao = $P{TIPO_ILUMINACAO}) AND
($P{TIPO_AREA} = 0 OR a.tipo_area = $P{TIPO_AREA}) AND
($P{TIPO_EQUIPAMENTO_SEGURANCA} = 0 OR a.tipo_equipamento_seguranca = $P{TIPO_EQUIPAMENTO_SEGURANCA}) AND
($P{SEXO} = 0 OR a.sexo = $P{SEXO}) AND
($P{FAIXA_ETARIA} = 0 OR a.faixa_etaria = $P{FAIXA_ETARIA}) AND
($P{TIPO_VEICULO} = 0 OR a.tipo_veiculo = $P{TIPO_VEICULO}) AND
($P{TIPO_ACIDENTE} = 0 OR a.tipo_acidente = $P{TIPO_ACIDENTE})]]></queryString>

	<field name="Data" class="java.sql.Timestamp"/>
	<field name="endereco" class="java.lang.String"/>
	<field name="Tipo Acidente" class="java.lang.String"/>

