<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="RelatorioImagensApNap"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="4279"
		 pageHeight="1445"
		 columnWidth="4219"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="DATA_INI" isForPrompting="true" class="java.sql.Timestamp"/>
	<parameter name="DATA_FIM" isForPrompting="true" class="java.sql.Timestamp"/>
	<parameter name="LOCAL" isForPrompting="true" class="java.lang.Integer"/>
	<parameter name="PISTA" isForPrompting="true" class="java.lang.Integer"/>
	<queryString><![CDATA[SELECT
	count(*) as quantidade,
	u.nome as Nome,
	e.descricao as Enquadramento,
	e.id_enquadramento as id_enquadramento,
	i.descricao as Inconsistencia
	
FROM [Consilux_GTW].[dbo].[infracao_completa] ic WITH (NOLOCK)
	JOIN [Consilux_GTW].[dbo].[inconsistencia] i WITH (NOLOCK) ON ic.id_inconsistencia = i.id_inconsistencia
	JOIN [Consilux_GTW].[dbo].[enquadramento] e WITH (NOLOCK) ON ic.id_enquadramento = e.id_enquadramento
	JOIN [Consilux_GTW].[dbo].[infracao_processo] ip WITH (NOLOCK) ON ic.id_infracao = ip.id_infracao
	JOIN [Consilux_GTW].[dbo].[sis_usuario] u WITH (NOLOCK) ON ip.id_usuario = u.id_usuario
WHERE
	ic.data_veiculo >= $P{DATA_INI}
	and
	ic.data_veiculo <= $P{DATA_FIM}
	and
	ic.id_local = $P{LOCAL}
	and
	($P{PISTA} = 0 OR ic.pista = $P{PISTA})
GROUP BY u.nome, e.descricao, i.descricao, e.id_enquadramento]]></queryString>

	<field name="quantidade" class="java.lang.Integer"/>
	<field name="Nome" class="java.lang.String"/>
	<field name="Enquadramento" class="java.lang.String"/>
	<field name="id_enquadramento" class="java.lang.Integer"/>
	<field name="Inconsistencia" class="java.lang.String"/>

