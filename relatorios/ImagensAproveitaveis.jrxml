	<parameter name="DATA_INI" isForPrompting="true" class="java.util.Date"/>
	<parameter name="DATA_FIM" isForPrompting="true" class="java.util.Date"/>
	<parameter name="ENQUADRAMENTO" isForPrompting="true" class="java.lang.Integer"/>
	<parameter name="DIR_IMAGENS" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["C:\\Documents and Settings\\edson.lopes\\workspace\\GTW_Taboao_Merge\\src\\main\\webapp\\WEB-INF\\img"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select 
	i.id_local,
	i.placa,
	ir.serie,
	ir.auto,
	e.id_enquadramento,
	e.descricao,
	i.data
	
	
from [Consilux_Taboao].[dbo].[infracao] i
	JOIN [Consilux_Taboao].[dbo].[infracao_remessa] ir ON ir.id_infracao = i.id_infracao
	JOIN [Consilux_Taboao].[dbo].[enquadramento] e ON e.id_enquadramento = i.id_enquadramento
where
	i.data >= $P{DATA_INI}
	and 
	i.data <= $P{DATA_FIM}
	and
	($P{ENQUADRAMENTO} = 0 OR e.id_enquadramento = $P{ENQUADRAMENTO})]]></queryString>

