	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="DATA_INI" isForPrompting="true" class="java.sql.Timestamp"/>
	<parameter name="DATA_FIM" isForPrompting="true" class="java.sql.Timestamp"/>
	<parameter name="LOCAL" isForPrompting="true" class="java.lang.Integer"/>
	<parameter name="PISTA" isForPrompting="true" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGENS" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["C:\\workspace\\GTW_URBS\\src\\main\\webapp\\WEB-INF\\img"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT 
	v.placa,
	v.data,
	v.velocidade,
	v.pista,
	v.id_local,
	cv.descricao
FROM 
	veiculo v WITH (NOLOCK)
		JOIN classe_veiculo cv WITH (NOLOCK) ON v.id_classe = cv.id_classe
WHERE
	v.placa is not null
	and
	v.data >= $P{DATA_INI}
	and
	v.data <= $P{DATA_FIM}
	and
	v.id_local = $P{LOCAL}
	and
	($P{PISTA} = 0 OR v.pista = $P{PISTA})
ORDER BY v.data]]></queryString>

	<field name="placa" class="java.lang.String"/>
	<field name="data" class="java.sql.Timestamp"/>
	<field name="velocidade" class="java.math.BigDecimal"/>
	<field name="pista" class="java.lang.Short"/>
	<field name="id_local" class="java.lang.Integer"/>
	<field name="descricao" class="java.lang.String"/>

