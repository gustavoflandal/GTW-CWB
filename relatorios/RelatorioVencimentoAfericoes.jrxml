	<property name="ireport.zoom" value="3.725527938355061"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="dataset1"/>
	<parameter name="CONTRATO" class="java.lang.String"/>
	<parameter name="CODIGO_SEGUNDARIO" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    ROW_NUMBER() OVER (ORDER BY DATA_VALIDADE) AS [ITEM],
    lv.serie_equipamento AS SERIE_EQUIPAMENTO,
    cep.cod_pista AS COD_LOCAL,
    cep.cod_pista_prodam AS COD_FAIXA,
    RTRIM(COALESCE(cep.nome_pista, '')) AS ENDERECO,
    cep.cod_pista_alternativo AS FAIXA,
    cea.selagem AS LACRE,
    cea.laudo AS DOCUMENTO,
    CAST(cea.data AS DATE) AS DATA_ULTIMA_AFERICAO
FROM
	local_vigente lv
	JOIN configuracao_equipamento_pista cep
		ON cep.id_configuracao_equipamento = lv.id_configuracao_equipamento
	JOIN configuracao_equipamento_afericao cea
		ON cea.id_configuracao_equipamento = lv.id_configuracao_equipamento
		AND cep.id_pista = cea.id_pista
WHERE
	lv.data_inicio IS NOT NULL AND lv.data_inicio <= GETDATE()
	AND (lv.data_fim IS NULL OR lv.data_fim >= GETDATE())
ORDER BY
	DATA_ULTIMA_AFERICAO]]>
	</queryString>
	<field name="ITEM" class="java.lang.Long"/>
	<field name="SERIE_EQUIPAMENTO" class="java.lang.Integer"/>
	<field name="COD_LOCAL" class="java.lang.Integer"/>
	<field name="COD_FAIXA" class="java.lang.Integer"/>
	<field name="ENDERECO" class="java.lang.String"/>
	<field name="FAIXA" class="java.lang.Integer"/>
	<field name="LACRE" class="java.lang.Integer"/>
	<field name="DOCUMENTO" class="java.lang.Integer"/>
	<field name="DATA_ULTIMA_AFERICAO" class="java.util.Date"/>
