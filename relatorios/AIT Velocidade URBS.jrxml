<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="AIT Velocidade URBS" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.6105100000000008"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="IMGS_INFRACAO" class="java.util.List" isForPrompting="false"/>
	<parameter name="DIR_IMAGENS" class="java.lang.String">
		<defaultValueExpression><![CDATA["c:"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	dbo.DAC_AIT(r.tipo,ir.serie,ir.auto) AS DAC_AUTO,
	ir.auto AS AUTO,
	RTRIM(ir.serie) AS SERIE,
	r.tipo AS TIPO_REMESSA,
	i.placa AS PLACA,
	RTRIM(COALESCE(cmcet2.descricao, cmcet.descricao, cm.descricao)) AS MARCA,
	COALESCE(ce2.descricao, ce.descricao) AS ESPECIE,
	'BRASIL' AS PAIS,
	COALESCE(cp.nome_pista, l.nome) AS LOCAL,
	v.data AS DATA_HORA,
	u.cod_agente AS AGENTE,
	e.id_enquadramento,
	RTRIM(e.descricao) AS ENQUADRAMENTO,
	i.velocidade_limite AS VELOCIDADE_REGULAMENTADA,
	v.velocidade AS VELOCIDADE,
	i.velocidade_considerada AS VELOCIDADE_CONSIDERADA,
	RTRIM(cast(cequip.serie_equipamento AS varchar(11))) + ' - ' + RTRIM(p.modelo) AS IDENTIFICACAO_EQUIPAMENTO,
	i.id_imagem_local AS NUMERO_IMAGEM,
	a.data AS DATA_AFERICAO,
	RTRIM(COALESCE(ir.sigla_infracao_cliente,'RAD')) + ' - FIXO' AS SIGLA_INFRACAO_CLIENTE
FROM infracao i
	JOIN #lista_infracoes li on li.id_infracao = i.id_infracao
	JOIN veiculo v ON v.id_veiculo = i.id_veiculo
	JOIN infracao_remessa ir ON ir.id_infracao = i.id_infracao
	JOIN remessa r ON r.id_remessa = ir.id_remessa
	LEFT JOIN cad_veiculo cv ON cv.placa = i.placa
	LEFT JOIN cad_marca cm ON cm.id_marca = cv.id_marca
	LEFT JOIN cad_marca_cet cmcet ON cmcet.id_marca_cet = cv.id_marca_cet
	LEFT JOIN cad_marca_cet_processo cmcetp ON cmcetp.placa = i.placa
	LEFT JOIN cad_marca_cet cmcet2 ON cmcet2.id_marca_cet = cmcetp.id_marca_cet
	LEFT JOIN cad_especie ce ON ce.id_especie = cv.id_especie
	LEFT JOIN cad_especie_processo cep ON cep.placa = i.placa
	LEFT JOIN cad_especie ce2 ON ce2.id_especie = cep.id_especie
	JOIN local l ON l.id_local = v.id_local AND l.sequencia_local = v.sequencia_local
	JOIN enquadramento e ON e.id_enquadramento = i.id_enquadramento
	LEFT JOIN sis_usuario u ON u.id_usuario = i.id_usuario_final
	JOIN configuracao_equipamento cequip ON cequip.id_configuracao_equipamento = l.id_configuracao_equipamento
	JOIN configuracao_equipamento_pista cp ON cp.id_configuracao_equipamento = cequip.id_configuracao_equipamento AND cp.id_pista = i.pista
	LEFT JOIN produto p ON p.id_produto = cequip.id_produto
	LEFT JOIN configuracao_equipamento_afericao a ON a.id_configuracao_equipamento = l.id_configuracao_equipamento AND a.id_pista = i.pista
ORDER BY li.ordem]]>
	</queryString>
