<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report1" pageWidth="1100" pageHeight="595" orientation="Landscape" columnWidth="1060" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.3057748147409245"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="dataset1"/>
	<parameter name="ANO" class="java.lang.Integer"/>
	<parameter name="MES" class="java.lang.Integer"/>
	<parameter name="VALIDAS" class="java.lang.Boolean"/>
	<queryString>
		<![CDATA[WITH busca_faixas
(SERIE_EQUIPAMENTO,COD_LOCAL,COD_FAIXA,ENDERECO,SENTIDO,FAIXA,ID_LOCAL,ID_PISTA)
AS (
	SELECT
		lv.serie_equipamento AS SERIE_EQUIPAMENTO,
		cep.cod_pista AS COD_LOCAL,
		cep.cod_pista_prodam AS COD_FAIXA,
		RTRIM(COALESCE(cep.nome_pista, '')) AS ENDERECO,
		RTRIM(COALESCE(cep.sentido, '')) AS SENTIDO,
		cep.cod_pista_alternativo AS FAIXA,
		lv.id_local AS [ID_LOCAL],
		cep.id_pista AS ID_PISTA
	FROM
		local_vigente lv
		JOIN configuracao_equipamento_pista cep WITH (NOLOCK)
			ON cep.id_configuracao_equipamento = lv.id_configuracao_equipamento
	WHERE
(
			(DATEPART(yy, lv.data_inicio) = $P{ANO}
			AND DATEPART(mm, lv.data_inicio) <= $P{MES})
	      OR (DATEPART(yy, lv.data_inicio) < $P{ANO})
	      )),

agrupa_infracoes(ID_LOCAL,ID_PISTA,ID_ENQUADRAMENTO,QTD)
AS (
    SELECT
        inf.id_local AS ID_LOCAL,
        inf.pista AS ID_PISTA,
        inf.id_enquadramento AS ID_ENQUADRAMENTO,
        COUNT(*) AS QTD
    FROM
        infracao inf WITH (NOLOCK)
    WHERE
        inf.id_enquadramento IN (60503, 56732, 59910, 60411, 60412, 74550, 74630, 74710)
        AND DATEPART(mm, inf.data) = $P{MES}
        AND DATEPART(yy, inf.data) = $P{ANO}
        AND
	(
           ($P{VALIDAS} = 1 AND inf.id_inconsistencia = 0)
		OR
           ($P{VALIDAS} = 0 AND inf.id_inconsistencia > 0)
        )

    GROUP BY
        inf.id_local,
        inf.pista,
        inf.id_enquadramento
),

totaliza_infracoes(ID_LOCAL,ID_PISTA,TOTAL)
AS (
    SELECT
        ai.ID_LOCAL,
        ai.ID_PISTA,
        SUM(ai.QTD) AS [TOTAL]
    FROM
        agrupa_infracoes ai WITH (NOLOCK)
    GROUP BY
        ai.ID_LOCAL,
        ai.ID_PISTA
)

SELECT
    ROW_NUMBER() OVER (ORDER BY bf.COD_LOCAL, bf.COD_FAIXA, bf.ID_LOCAL, bf.ID_PISTA) AS [ITEM],
    bf.SERIE_EQUIPAMENTO,
    bf.COD_LOCAL,
    bf.COD_FAIXA,
    bf.ENDERECO,
    bf.SENTIDO,
    bf.FAIXA,

    --AVANÇO SINAL
    COALESCE((SELECT QTD FROM agrupa_infracoes WHERE ID_ENQUADRAMENTO = 60503
    AND bf.ID_LOCAL=ID_LOCAL AND bf.ID_PISTA=ID_PISTA), 0) AS [60503],

    --PARADA SOBRE FAIXA
    COALESCE((SELECT QTD FROM agrupa_infracoes WHERE ID_ENQUADRAMENTO = 56732
    AND bf.ID_LOCAL=ID_LOCAL AND bf.ID_PISTA=ID_PISTA), 0) AS [56732],

    --RETORNO PROIBIDO
    COALESCE((SELECT QTD FROM agrupa_infracoes WHERE ID_ENQUADRAMENTO = 59910
    AND bf.ID_LOCAL=ID_LOCAL AND bf.ID_PISTA=ID_PISTA), 0) AS [59910],

    --CONV. DIREITA
    COALESCE((SELECT QTD FROM agrupa_infracoes WHERE ID_ENQUADRAMENTO = 60411
    AND bf.ID_LOCAL=ID_LOCAL AND bf.ID_PISTA=ID_PISTA), 0) AS [60411],

    --CONV ESQUERDA
    COALESCE((SELECT QTD FROM agrupa_infracoes WHERE ID_ENQUADRAMENTO = 60412
    AND bf.ID_LOCAL=ID_LOCAL AND bf.ID_PISTA=ID_PISTA), 0) AS [60412],

    --VELOCIDADE <= 20%
    COALESCE((SELECT QTD FROM agrupa_infracoes WHERE ID_ENQUADRAMENTO = 74550
    AND bf.ID_LOCAL=ID_LOCAL AND bf.ID_PISTA=ID_PISTA), 0) AS [74550],

    --VELOCIDADE 20-50%
    COALESCE((SELECT QTD FROM agrupa_infracoes WHERE ID_ENQUADRAMENTO = 74630
    AND bf.ID_LOCAL=ID_LOCAL AND bf.ID_PISTA=ID_PISTA), 0) AS [74630],

    --VELOCIDADE > 50%
    COALESCE((SELECT QTD FROM agrupa_infracoes WHERE ID_ENQUADRAMENTO = 74710
    AND bf.ID_LOCAL=ID_LOCAL AND bf.ID_PISTA=ID_PISTA), 0) AS [74710],
    COALESCE(ti.TOTAL, 0) AS [TOTAL]
FROM
    busca_faixas AS bf
    LEFT JOIN totaliza_infracoes ti
        ON ti.ID_LOCAL = bf.ID_LOCAL
        AND ti.ID_PISTA = bf.ID_PISTA
ORDER BY
    bf.COD_LOCAL, bf.COD_FAIXA, bf.ID_LOCAL, bf.ID_PISTA]]>
	</queryString>
