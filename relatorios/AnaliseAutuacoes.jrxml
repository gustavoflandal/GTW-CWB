<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="AnaliseAutuacoes"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="1190"
		 pageHeight="842"
		 columnWidth="1130"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="DIGITADOR" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Todos"]]></defaultValueExpression>
	</parameter>
	<parameter name="DATA_INICIAL" isForPrompting="true" class="java.sql.Timestamp"/>
	<parameter name="DATA_FINAL" isForPrompting="true" class="java.sql.Timestamp"/>
	<parameter name="LOCAL" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Todos"]]></defaultValueExpression>
	</parameter>
	<parameter name="ID_LOCAL" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="PISTA" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="ID_GRUPO_DIGITADOR" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[4]]></defaultValueExpression>
	</parameter>
	<parameter name="ID_DIGITADOR" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="AUDITOR" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Todos"]]></defaultValueExpression>
	</parameter>
	<parameter name="ID_AUDITOR" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="ID_GRUPO_AUDITOR" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[5]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select 
	id_enquadramento,
	nome as processo,
	estado,
	sum(total) as total
from 
(
	select
		case 
			when t.id_processo = 1 then 1
			when t.id_processo = 2 then 2
			when t.id_processo = 11 then 3
			when t.id_processo = 3 then 4
		end as ordem_processo,
		t.id_processo,
		id_enquadramento,
		p.nome,
		estado,
		ordem_estado,
		sum(total) as total
	from 
		(
			select
				i.id_infracao,
				i.id_enquadramento,
				'inconsistidas' as estado,
				2 as ordem_estado,
				1 as total,
				ipc.id_processo
			from
				infracao i with (NOLOCK)
				left join infracao_processo_concluido ipc with (NOLOCK) on (ipc.id_infracao = i.id_infracao)
				left join processo p with (NOLOCK) on (p.id_processo = ipc.id_processo)
				
			where
				p.ativo = 'True' and
				ipc.data_conclusao between $P{DATA_INICIAL} and $P{DATA_FINAL} and
				($P{ID_LOCAL} = 0 or i.id_local = $P{ID_LOCAL}) and
				($P{PISTA} = 0 or i.pista = $P{PISTA}) and
				(ipc.id_processo in (1,2,3,11) ) and
				ipc.id_inconsistencia <> 0
				and i.id_infracao in (
								select 
									id_infracao 
								from 
									infracao_processo with (NOLOCK)
								where 
									( $P{ID_DIGITADOR} = 0 or id_usuario = $P{ID_DIGITADOR} )
								INTERSECT
								select 
									id_infracao 
								from 
									infracao_processo with (NOLOCK)
								where 
									( $P{ID_AUDITOR} = 0 or id_usuario = $P{ID_AUDITOR} )
								group by
									id_infracao
								)
			UNION
			select
				i.id_infracao,
				i.id_enquadramento,
				'consistidas' as estado,
				1 as ordem_estado,
				1 as total,
				ipc.id_processo
			from
				infracao i with (NOLOCK)
				left join infracao_processo_concluido ipc with (NOLOCK) on (ipc.id_infracao = i.id_infracao)
				left join processo p with (NOLOCK) on (p.id_processo = ipc.id_processo)
				
			where
				p.ativo = 'True' and
				ipc.data_conclusao between $P{DATA_INICIAL} and $P{DATA_FINAL} and
				($P{ID_LOCAL} = 0 or i.id_local = $P{ID_LOCAL}) and
				($P{PISTA} = 0 or i.pista = $P{PISTA}) and
				(ipc.id_processo in (1,2,3,11) ) and
				(ipc.id_inconsistencia = 0 or ipc.id_inconsistencia is null)
				and i.id_infracao in (
								select 
									id_infracao 
								from 
									infracao_processo with (NOLOCK)
								where 
									( $P{ID_DIGITADOR} = 0 or id_usuario = $P{ID_DIGITADOR} )
								INTERSECT
								select 
									id_infracao 
								from 
									infracao_processo with (NOLOCK)
								where 
									( $P{ID_AUDITOR} = 0 or id_usuario = $P{ID_AUDITOR} )
								group by
									id_infracao
								)
			UNION
			select
				i.id_infracao,
				i.id_enquadramento,
				'divergencias' as estado,
				3 as ordem_estado,
				1 as total,
				ipc.id_processo
			from
				infracao i with (NOLOCK)
				left join infracao_processo_concluido ipc with (NOLOCK) on (ipc.id_infracao = i.id_infracao)
				left join processo p with (NOLOCK) on (p.id_processo = ipc.id_processo)
			where
				p.ativo = 'True' and
				ipc.data_conclusao between $P{DATA_INICIAL} and $P{DATA_FINAL} and
				($P{ID_LOCAL} = 0 or i.id_local = $P{ID_LOCAL}) and
				($P{PISTA} = 0 or i.pista = $P{PISTA}) and
				(ipc.id_processo in (1,2,3,11) ) and
				(select id_inconsistencia from infracao_processo_concluido where id_infracao = i.id_infracao and id_processo = p.id_processo_anterior) <> ipc.id_inconsistencia
				and i.id_infracao in (
								select 
									id_infracao 
								from 
									infracao_processo with (NOLOCK)
								where 
									( $P{ID_DIGITADOR} = 0 or id_usuario = $P{ID_DIGITADOR} )
								INTERSECT
								select 
									id_infracao 
								from 
									infracao_processo with (NOLOCK)
								where 
									( $P{ID_AUDITOR} = 0 or id_usuario = $P{ID_AUDITOR} )
								group by
									id_infracao
								)
		) as t 
		left join processo p with (NOLOCK) on (p.id_processo = t.id_processo)
	group by
		id_enquadramento,
		t.id_processo,
		p.nome,
		estado,
		ordem_estado
	UNION
	select 
		case 
			when id_processo = 1 then 1
			when id_processo = 2 then 2
			when id_processo = 11 then 3
			when id_processo = 3 then 4
		end as ordem_processo,
		id_processo,
		id_enquadramento, 
		nome,
		estado,
		ordem_estado,
		total
	from
	(
		select 
			id_processo,
			e.id_enquadramento, 
			p.nome,
			'consistidas' as estado,
			1 as ordem_estado,
			0 as total
		from 
			processo p with (NOLOCK), enquadramento e with (NOLOCK)

		UNION
		select 
			id_processo,
			e.id_enquadramento, 
			p.nome,
			'inconsistidas' as estado,
			2 as ordem_estado,
			0 as total
		from 
			processo p with (NOLOCK), enquadramento e with (NOLOCK)
			
		UNION
		select 
			id_processo,
			e.id_enquadramento, 
			p.nome,
			'divergencias' as estado,
			3 as ordem_estado,
			0 as total
		from 
			processo p with (NOLOCK), enquadramento e with (NOLOCK)
	) as t
	
) as t
where
	id_processo in (1,2,3,11)
group by
	id_enquadramento,
	ordem_processo,
	ordem_estado,
	nome,
	estado
order by
	id_enquadramento,
	ordem_processo]]></queryString>

