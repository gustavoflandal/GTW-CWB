	<queryString>
		<![CDATA[DECLARE @placa VARCHAR(7) = $P{placa},
		@dataIni DATETIME = $P{data_inicio},
		@dataFim DATETIME  = $P{data_fim},
		@equipamento VARCHAR(1600) = $P{equipamento},
		@faixa VARCHAR(100) = $P{faixa},
		@classificacao VARCHAR(50) = $P{classificacao},
		@buscarApenasVeiculoComImagem BIT = $P{buscarApenasVeiculoComImagem},
		@consultaMapa BIT = $P{consultaMapa},
		@exportarConsulta BIT = $P{exportarConsulta}

EXEC muralha.spu_obterVeiculosPorFiltros @placa, @dataIni, @dataFim, @equipamento, @faixa, @classificacao, @buscarApenasVeiculoComImagem, @consultaMapa, @exportarConsulta]]>
