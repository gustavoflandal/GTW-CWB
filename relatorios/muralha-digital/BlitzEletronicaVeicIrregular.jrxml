	<parameter name="DIR_IMAGENS" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Documents and Settings\\fos\\workspace\\GTW\\src\\main\\webapp\\WEB-INF\\img"]]></defaultValueExpression>
	</parameter>
	<parameter name="IMGS_INFRACAO" class="java.util.List" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT id,
		   placa,
		   data,
		   velocidade,
		   id_local,
		   nome_local,
		   nome,
		   id_pista,
		   faixa,
		   tipo_alerta,
		   nome_monitorado,
		   placa_monitorada,
		   data_alerta,
		   status_alerta,
		   (SELECT img_obj AS '*' FOR XML PATH('')) AS imagem_b64
	FROM   (
				SELECT vtr.id,
					   vtr.placa,
					   vtr.data,
					   vtr.velocidade,
					   vtr.id_local,
					   lpv.nome_local,
					   RTRIM(lpv.nome) AS nome,
					   vtr.id_pista,
					   lpv.cod_pista_alternativo AS faixa,
					   tao.tipo AS tipo_alerta,
					   cev.nome AS nome_monitorado,
					   cev.placa AS placa_monitorada,
					   a.data AS data_alerta,
					   s.descricao AS status_alerta,
					   CAST(vtri.imagem AS VARBINARY(MAX)) AS img_obj
				FROM   muralha.veiculo_tempo_real vtr (NOLOCK)
					   INNER JOIN local_pista_vigente lpv
							ON  lpv.id_local = vtr.id_local
								AND lpv.id_pista = vtr.id_pista
					   INNER JOIN muralha.alerta_veiculo av
							ON  av.id_veiculo_tempo_real = vtr.id
					   INNER JOIN muralha.alerta a
							ON  a.id = av.id_alerta
					   INNER JOIN muralha.cad_veiculo_monitorado cev
							ON  cev.id = a.id_cad_veiculo_monitorado
					   INNER JOIN muralha.tipo_alerta_ocorrencia tao
							ON  tao.id = a.id_tipo_alerta_ocorrencia
					   INNER JOIN muralha.status_alerta s
							ON  s.id = a.id_status_alerta
					   INNER JOIN muralha.veiculo_tempo_real_imagem vtri
							ON  vtri.id_veiculo_tempo_real = vtr.id
				WHERE  vtr.id = 'C0BAA434-C84B-4929-B2CC-EFB1D1C3E177' --webp
				--WHERE  vtr.id = 'B2068360-9284-47CF-B5AF-29D2159F4C5F'
					   AND vtri.indice_imagem = 0
		   ) a
	ORDER BY
		   data,
		   data_alerta]]>
	</queryString>
