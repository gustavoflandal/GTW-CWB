	<parameter name="data_inicio" class="java.sql.Timestamp"/>
	<parameter name="data_fim" class="java.sql.Timestamp"/>
	<queryString>
		<![CDATA[DECLARE @data_inicio DATETIME = $P{data_inicio}
DECLARE @data_fim DATETIME = $P{data_fim}

SELECT data_alerta,
	   tipo_alerta,
	   equipamento,
	   placa_lida,
	   placa_monitorada,
	   data_cadastro_monitoramento,
	   data_inicio_monitoramento,
	   data_fim_monitoramento,
	   situacao_cadastro,
	   usuario_alerta
FROM   muralha.fcn_relAlertasDetalhado(@data_inicio, @data_fim)]]>
	</queryString>
