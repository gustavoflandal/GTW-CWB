    <queryString>
        <![CDATA[EXEC dbo.spu_obterVeiculosGtwPorFiltros 
    @placa = $P{placa},
    @dataIni = $P{data_inicio},
    @dataFim = $P{data_fim},
    @equipamentos = $P{equipamento},
    @faixa = $P{faixa},
    @classificacao = $P{classificacao},
    @buscarApenasVeiculoComImagem = $P{buscarApenasVeiculoComImagem},
    @consultaMapa = 0,
    @exportarConsulta = 1,
    @offset = 0,
    @itensPorPagina = 999999,
