	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="DATA_INI" isForPrompting="true" class="java.sql.Timestamp"/>
	<parameter name="DATA_FIM" isForPrompting="true" class="java.sql.Timestamp"/>
	<queryString><![CDATA[SELECT 
	loc.serie_equipamento as Equipamento,
	loc.Data as Data,
	(CASE WHEN (ev.Quantidade IS NULL)
	THEN 0
	ELSE ev.Quantidade
	END) as Quantidade
FROM
	(SELECT
		CAST(dte.Data as DATE) as Data,
		lcl.serie_equipamento
	FROM
		[Date_Table]($P{DATA_INI}, $P{DATA_FIM}) as dte,
		[Consilux_GTW].[dbo].[local_vigente] as lcl
	) as loc
	LEFT JOIN 
		(SELECT
			COUNT(*) as Quantidade,
			CAST(ev.data_hora as DATE) as Data,
			ev.proprietario
		FROM
			eventos_csx ev
		WHERE
			ev.data_hora >= $P{DATA_INI}
			AND
			ev.data_hora <= $P{DATA_FIM}
			AND
			ev.id_evento = 15
		GROUP BY
			CAST(ev.data_hora as DATE),
			ev.proprietario
		) as ev ON CAST(ev.proprietario as Int) = loc.serie_equipamento
		AND
		ev.Data = loc.Data
GROUP BY loc.serie_equipamento,
	loc.Data,
	ev.Quantidade,
	ev.proprietario]]></queryString>

	<field name="Equipamento" class="java.lang.Integer"/>
	<field name="Data" class="java.lang.String"/>
	<field name="Quantidade" class="java.lang.Integer"/>

