	<field name="data_solicitacao" class="java.sql.Timestamp"/>
	<field name="data_imagens" class="java.util.Date"/>
	<field name="id_enquadramento" class="java.lang.Integer"/>
	<field name="desc_enquadramento" class="java.lang.String"/>
