	<parameter name="DESTINO" class="java.lang.String"/>
	<parameter name="DIR_IMAGENS" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Workspace_GTW\\GTW\\src\\main\\webapp\\WEB-INF\\img"]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGO_EMPRESA" class="java.lang.String"/>
	<parameter name="IDENTIFICACAO" class="java.lang.String"/>
	<parameter name="ID_SOLICITACAO_AUDITORIA" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	sai.id_solicitacao_auditoria,
	u.nome AS responsavel,
	sa.data_geracao AS data_solicitacao,
	sa.data_imagens,
	e.id_enquadramento,
	e.descricao AS desc_enquadramento,
	count(ii.id_infracao) AS total_inconsistentes,
	count(ic.id_infracao) AS total_consistentes,
	count(ii.id_infracao)+count(ic.id_infracao) AS total_imagens
FROM
	solicitacao_auditoria sa
	JOIN sis_usuario u ON u.id_usuario = sa.id_usuario
	JOIN infracao i WITH (NOLOCK) ON CAST(i.data as DATE) = sa.data_imagens
	JOIN enquadramento e ON e.id_enquadramento = i.id_enquadramento AND e.id_enquadramento > 1
	LEFT JOIN solicitacao_auditoria _sa ON _sa.id_solicitacao_auditoria <= sa.id_solicitacao_auditoria AND _sa.data_imagens = sa.data_imagens
	LEFT JOIN solicitacao_auditoria_infracao sai ON sai.id_infracao = i.id_infracao AND sai.id_solicitacao_auditoria = _sa.id_solicitacao_auditoria
	LEFT JOIN infracao ii WITH (NOLOCK) ON ii.id_infracao = sai.id_infracao AND ii.id_inconsistencia > 0
	LEFT JOIN infracao ic WITH (NOLOCK) ON ic.id_infracao = sai.id_infracao AND ic.id_inconsistencia = 0
WHERE
	sa.id_solicitacao_auditoria = $P{ID_SOLICITACAO_AUDITORIA} AND
	sai.id_solicitacao_auditoria IS NOT NULL
GROUP BY
	sai.id_solicitacao_auditoria,
	u.nome,
	sa.data_geracao,
	sa.data_imagens,
	e.id_enquadramento,
	e.descricao
ORDER BY
	sai.id_solicitacao_auditoria DESC,e.id_enquadramento]]>
	</queryString>
