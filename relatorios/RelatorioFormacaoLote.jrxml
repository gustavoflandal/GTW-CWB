<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RelatorioFormacaoLote" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="6efcec96-3afd-42d8-845d-9c06a1be22da">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="DIR_IMAGENS" class="java.lang.String">
		<defaultValueExpression><![CDATA["C:\\Coisas\\Java\\Teste\\Workspace\\GTW\\src\\main\\webapp\\WEB-INF\\img"]]></defaultValueExpression>
	</parameter>
	<parameter name="DESCRICAO_LOTE" class="java.lang.String"/>
	<parameter name="ID_REMESSA" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT  ir.sequencia, p.nome AS processo, su.nome AS usuario, CONVERT(DATE,ip.data) AS data,
sub2.min_data, sub2.max_data
FROM infracao i (NOLOCK)
JOIN (SELECT id_infracao, MAX(id_infracao_processo) AS id_infracao_processo
FROM infracao_processo WHERE id_processo IN (1,2) GROUP BY id_infracao) AS sub1
	ON i.id_infracao = sub1.id_infracao
JOIN infracao_processo ip (NOLOCK) ON sub1.id_infracao_processo = ip.id_infracao_processo
JOIN sis_usuario su (NOLOCK) ON ip.id_usuario = su.id_usuario
JOIN processo p (NOLOCK) ON p.id_processo = ip.id_processo
JOIN infracao_remessa ir (NOLOCK) ON i.id_infracao = ir.id_infracao

JOIN (SELECT infracao_remessa.id_remessa,
MIN(infracao.data) AS min_data, MAX(infracao.data) AS max_data
FROM infracao (NOLOCK) JOIN infracao_remessa (NOLOCK)
ON infracao.id_infracao = infracao_remessa.id_infracao
GROUP BY infracao_remessa.id_remessa) AS sub2 ON sub2.id_remessa = ir.id_remessa

WHERE ir.id_remessa = $P{ID_REMESSA}

ORDER BY 1]]>
	</queryString>
	<field name="sequencia" class="java.lang.String"/>
	<field name="processo" class="java.lang.String"/>
	<field name="usuario" class="java.lang.String"/>
	<field name="data" class="java.util.Date"/>
	<field name="min_data" class="java.sql.Timestamp"/>
	<field name="max_data" class="java.sql.Timestamp"/>
