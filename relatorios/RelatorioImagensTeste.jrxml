	<parameter name="PERC_PISTAS_COMPLETAS" class="java.lang.Double"/>
	<parameter name="DATA_RELATORIO" class="java.sql.Timestamp"/>
	<parameter name="ID_PROCESSO" class="java.lang.Integer"/>
	<parameter name="DIR_IMAGENS" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Workspace_GTW\\GTW\\src\\main\\webapp\\WEB-INF\\img"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	lv.serie_equipamento,
	lv.data_inicio,
	cp.nome_pista,
	cp.cod_pista_alternativo AS cod_pista,
	inc.id_inconsistencia,
	RTRIM(inc.descricao) AS inconsistencia,
	count(i.id_infracao) AS conta
FROM
	configuracao_equipamento_pista cp
	JOIN local_vigente lv ON lv.id_configuracao_equipamento = cp.id_configuracao_equipamento
	LEFT JOIN infracao i ON i.id_local = lv.id_local AND i.pista = cp.id_pista
		AND CAST(i.data AS DATE) BETWEEN $P{DATA_INICIO} AND $P{DATA_FIM}
	LEFT JOIN infracao_processo_concluido ic ON ic.id_infracao = i.id_infracao AND ic.id_processo = $P{ID_PROCESSO}
	LEFT JOIN infracao _i ON _i.id_infracao = ic.id_infracao
	LEFT JOIN inconsistencia inc ON inc.id_inconsistencia = _i.id_inconsistencia
		AND (inc.id_inconsistencia IS NULL OR inc.razao_tecnica = 2)
WHERE
	i.id_infracao IS NULL OR (
		$P{ID_PROCESSO} IN (ic.id_processo,i.id_processo)
	)
GROUP BY
	lv.serie_equipamento,
	lv.data_inicio,
	cp.nome_pista,
	cp.cod_pista_alternativo,
	case when (inc.id_inconsistencia is null) then 1 else 0 end,
	inc.descricao,
	inc.id_inconsistencia
ORDER BY case when (inc.id_inconsistencia is null) then 1 else 0 end, count(i.id_infracao) desc, lv.serie_equipamento]]>
	</queryString>
	<field name="serie_equipamento" class="java.lang.Integer"/>
	<field name="data_inicio" class="java.sql.Timestamp"/>
	<field name="nome_pista" class="java.lang.String"/>
	<field name="cod_pista" class="java.lang.Integer"/>
	<field name="id_inconsistencia" class="java.lang.Integer"/>
	<field name="inconsistencia" class="java.lang.String"/>
	<field name="conta" class="java.lang.Integer"/>
	<variable name="CONTA_PISTA" class="java.lang.Integer" resetType="Group" resetGroup="serie" calculation="Count">
		<variableExpression><![CDATA[$F{cod_pista}]]></variableExpression>
	</variable>
	<variable name="SOMA_CONTA" class="java.lang.Integer" resetType="Group" resetGroup="serie" calculation="Sum">
		<variableExpression><![CDATA[$F{conta}]]></variableExpression>
	</variable>
	<filterExpression><![CDATA[$F{conta} == 0 || ($F{conta} > 0 && $F{id_inconsistencia} > 0)]]></filterExpression>
	<group name="serie" isStartNewPage="true">
		<groupExpression><![CDATA[new Boolean($F{inconsistencia} == null)]]></groupExpression>
