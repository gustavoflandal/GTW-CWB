	<parameter name="DATA_FIM" class="java.util.Date"/>
	<parameter name="TOTAL_IMAGENS" class="java.lang.Integer"/>
	<parameter name="LOGO_EMPRESA" class="java.lang.String"/>
	<parameter name="TOTAL_IMAGENS_VERIFICADAS" class="java.lang.Integer"/>
	<parameter name="TOTAL_PISTAS" class="java.lang.Integer"/>
