	<parameter name="DESTINO" class="java.lang.String"/>
	<parameter name="DIR_IMAGENS" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Workspace_GTW\\GTW\\src\\main\\webapp\\WEB-INF\\img"]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGO_EMPRESA" class="java.lang.String"/>
	<parameter name="IDENTIFICACAO" class="java.lang.String"/>
	<parameter name="ID_PROCESSO_MEDICAO" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	id_processo_medicao,
	data_exportacao AS data_entrega,
	periodo_ini as data_ini,
	periodo_fim as data_fim,
	u.nome AS responsavel
FROM processo_medicao pm
JOIN sis_usuario u ON u.id_usuario = pm.id_usuario_responsavel
WHERE pm.id_processo_medicao = $P{ID_PROCESSO_MEDICAO}]]>
	</queryString>
	<field name="id_processo_medicao" class="java.lang.Integer"/>
	<field name="data_entrega" class="java.sql.Timestamp"/>
	<field name="data_ini" class="java.sql.Timestamp"/>
	<field name="data_fim" class="java.sql.Timestamp"/>
	<field name="responsavel" class="java.lang.String"/>
