	<parameter name="LOGO_EMPRESA_VERTICAL" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT top(1) 
r.data AS DATA_MOVIMENTO,
REPLACE(CONVERT(VARCHAR(8), r.data, 3), '/', '') AS DATA_MOVIMENTO_FORMATADA,
RTRIM(r.tipo) AS TIPO_REMESSA,
right('000000'+RTRIM(r.codigo_externo), 6) AS NUMERO_REMESSA,
RTRIM(r.serie_inicial) AS SERIE_INI,
right('00000000'+RTRIM(r.auto_inicial), 8) AS AUTO_INI,
dbo.DAC_AIT(r.tipo,r.serie_inicial,r.auto_inicial) AS DINI,
RTRIM(r.serie_final) AS SERIE_FIM,
right('00000000'+RTRIM(r.auto_final), 8) AS AUTO_FIM,
dbo.DAC_AIT(r.tipo,r.serie_final,r.auto_final) AS DFIM,
right('000000'+RTRIM(r.total_infracao), 6) AS CONTA_AIT,
total_infracao AS NUMERO_IMAGENS,
CONVERT(VARCHAR, data_inicial, 3) AS DATA_INICIO,
CONVERT(VARCHAR, data_final, 3) AS DATA_FIM,
(SELECT valor FROM chave_valor (NOLOCK) WHERE chave = 'nome_contrato_remessa') AS NOME_CONTRATO
FROM remessa r
WHERE r.id_remessa = $P{ID_REMESSA}]]>
	</queryString>
