	<parameter name="ID_REMESSA" class="java.lang.Integer"/>
	<parameter name="DIR_IMAGENS" class="java.lang.String">
		<defaultValueExpression><![CDATA["c:"]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGO_EMPRESA" class="java.lang.String">
