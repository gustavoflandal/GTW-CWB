<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report1" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="conta_infracao_hora">
		<parameter name="COD_PISTA" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="DATA" class="java.util.Date">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[DECLARE @DATA DATE = $P{DATA};
DECLARE @COD_PISTA INT = $P{COD_PISTA};
SELECT SUM(v.trafego) as trafego, SUM(i.conta) as conta_infracao, v.hora FROM local_vigente lv
JOIN configuracao_equipamento_pista cp ON cp.id_configuracao_equipamento = lv.id_configuracao_equipamento
JOIN (
SELECT sum(vs.trafego) as trafego, vs.hora, vs.id_local, vs.sequencia_local, vs.pista
FROM veiculo_sumarizado vs WITH (NOLOCK)
WHERE
vs.data = @DATA
GROUP BY vs.hora, vs.id_local, vs.sequencia_local, vs.pista
) as v ON v.id_local = lv.id_local AND v.pista = cp.id_pista
LEFT JOIN (
SELECT count(i.id_infracao) as conta, datepart(hh,data) as hora, i.id_local, i.sequencia_local, i.pista
FROM infracao i
WHERE
CAST(i.data AS DATE) = @DATA AND i.id_enquadramento IN (74550, 74630, 74710)
GROUP BY datepart(hh,data), i.id_local, i.sequencia_local, i.pista
) as i ON i.id_local = lv.id_local AND i.pista = cp.id_pista AND i.hora = v.hora
WHERE
cp.cod_pista = @COD_PISTA
GROUP BY v.hora, v.id_local
ORDER BY v.hora]]>
		</queryString>
		<field name="trafego" class="java.lang.Integer"/>
		<field name="conta_infracao" class="java.lang.Integer"/>
		<field name="hora" class="java.lang.Integer"/>
	</subDataset>
	<parameter name="ANO" class="java.lang.Integer"/>
	<parameter name="MES" class="java.lang.Integer"/>
	<parameter name="IDENTIFICACAO_CLIENTE" class="java.lang.String"/>
	<queryString>
		<![CDATA[DECLARE @MES INT = $P{MES}
DECLARE @ANO INT = $P{ANO}
DECLARE @DATA_INI DATE = STR(@ANO)+'-'+STR(@MES)+'-01' DECLARE @DATA_FIM DATE = DATEADD(s,-1,DATEADD(mm, DATEDIFF(m,0,@DATA_INI)+1,0))
SELECT DISTINCT /*TOP 50*/ cp.cod_pista, vs.data, RTRIM(cp.nome_pista) as nome_pista
FROM veiculo_sumarizado vs
JOIN local_vigente lv ON lv.id_local = vs.id_local
JOIN configuracao_equipamento_pista cp ON cp.id_configuracao_equipamento = lv.id_configuracao_equipamento AND cp.id_pista = vs.pista
WHERE vs.data BETWEEN @DATA_INI AND @DATA_FIM AND vs.data >= lv.data_inicio ORDER BY cp.cod_pista, data]]>
	</queryString>
	<field name="cod_pista" class="java.lang.Integer"/>
	<field name="data" class="java.util.Date"/>
	<field name="nome_pista" class="java.lang.String"/>
	<group name="pista" isStartNewPage="true">
		<groupExpression><![CDATA[$F{cod_pista}]]></groupExpression>
		<groupHeader>
			<band height="40">
				<textField>
					<reportElement x="0" y="11" width="555" height="20"/>
					<textElement textAlignment="Center">
						<font fontName="Calibri" size="11" isBold="true"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{cod_pista}+" - "+$F{nome_pista}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
		<groupFooter>
			<band/>
		</groupFooter>
	</group>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="104" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="555" height="20"/>
				<textElement markup="none"/>
				<textFieldExpression class="java.lang.String"><![CDATA["RELATÓRIO MENSAL DE SEGURANÇA NO TRÂNSITO POR DIA"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="20" width="67" height="20"/>
				<textElement/>
				<text><![CDATA[CONTRATO:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="40" width="67" height="20"/>
				<textElement/>
				<text><![CDATA[PERÍODO:]]></text>
			</staticText>
			<textField pattern="MMMM-yyyy" isBlankWhenNull="true">
				<reportElement x="67" y="40" width="488" height="20"/>
				<textElement/>
				<textFieldExpression class="java.util.Date"><![CDATA[new Date($P{ANO} - 1900, $P{MES} - 1, 1)]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="20" width="488" height="20"/>
				<textElement markup="none"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{IDENTIFICACAO_CLIENTE}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="70" width="555" height="25"/>
				<box topPadding="1" leftPadding="1" bottomPadding="1" rightPadding="1"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Calibri" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Relatório de Quantidade de Infrações (Excesso de velocidade)
]]></text>
			</staticText>
		</band>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="191" splitType="Stretch">
			<textField pattern="dd/MM/yyyy&apos; (&apos;E&apos;)&apos;">
				<reportElement x="0" y="0" width="555" height="20"/>
				<textElement textAlignment="Center">
					<font fontName="Calibri" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.util.Date"><![CDATA[$F{data}]]></textFieldExpression>
			</textField>
			<barChart>
				<chart customizerClass="com.consilux.infra.CsxBarChartCustomizer">
					<reportElement x="0" y="20" width="555" height="160"/>
					<chartTitle/>
					<chartSubtitle/>
					<chartLegend position="Bottom"/>
				</chart>
				<categoryDataset>
					<dataset>
						<datasetRun subDataset="conta_infracao_hora">
							<datasetParameter name="COD_PISTA">
								<datasetParameterExpression><![CDATA[$F{cod_pista}]]></datasetParameterExpression>
							</datasetParameter>
							<datasetParameter name="DATA">
								<datasetParameterExpression><![CDATA[$F{data}]]></datasetParameterExpression>
							</datasetParameter>
						</datasetRun>
					</dataset>
					<categorySeries>
						<seriesExpression><![CDATA["Excesso de Velocidade"]]></seriesExpression>
						<categoryExpression><![CDATA[$F{hora}]]></categoryExpression>
						<valueExpression><![CDATA[$F{conta_infracao}]]></valueExpression>
					</categorySeries>
					<categorySeries>
						<seriesExpression><![CDATA["Tráfego de Veículos"]]></seriesExpression>
						<categoryExpression><![CDATA[$F{hora}]]></categoryExpression>
						<valueExpression><![CDATA[$F{trafego}]]></valueExpression>
					</categorySeries>
				</categoryDataset>
				<barPlot isShowLabels="true">
					<plot/>
					<itemLabel color="#000000" backgroundColor="#FFFFFF">
						<font size="5"/>
					</itemLabel>
					<categoryAxisLabelExpression><![CDATA["Hora do Dia"]]></categoryAxisLabelExpression>
					<categoryAxisFormat>
						<axisFormat labelColor="#000000" tickLabelColor="#000000" tickLabelMask="00'h'" verticalTickLabels="true" axisLineColor="#000000">
							<labelFont/>
							<tickLabelFont/>
						</axisFormat>
					</categoryAxisFormat>
					<valueAxisLabelExpression><![CDATA["Tráfego"]]></valueAxisLabelExpression>
					<valueAxisFormat>
						<axisFormat labelColor="#000000" tickLabelColor="#000000" verticalTickLabels="false" axisLineColor="#000000">
							<labelFont/>
							<tickLabelFont/>
						</axisFormat>
					</valueAxisFormat>
				</barPlot>
			</barChart>
		</band>
	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band splitType="Stretch"/>
	</pageFooter>
	<summary>
		<band splitType="Stretch"/>
	</summary>
</jasperReport>
