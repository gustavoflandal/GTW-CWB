	</parameter>
	<parameter name="LOGO_EMPRESA" class="java.lang.String"/>
	<parameter name="LOGO_EMPRESA_VERTICAL" class="java.lang.String"/>
	<parameter name="ID_DESCARGA" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT top 1
d.data_criacao AS DATA_DESCARGA,
CAST(d.dia_inicio AS DATETIME) AS DATA_INICIO,
CAST(d.dia_fim AS DATETIME) AS DATA_FIM,
right('000000'+RTRIM(d.id_descarga), 6) AS ID_DESCARGA,
right('000000'+RTRIM(d.total_imagens), 6) AS TOTAL_IMAGENS,
RTRIM(d.identificacao_cliente) AS IDENTIFICACAO_CLIENTE
FROM descarga_descarga d
WHERE d.id_descarga = $P{ID_DESCARGA}]]>
	</queryString>
	<field name="DATA_DESCARGA" class="java.sql.Timestamp"/>
	<field name="DATA_INICIO" class="java.sql.Timestamp"/>
